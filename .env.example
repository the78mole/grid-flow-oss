# .env file for docker-compose
# Copy this to .env and modify as needed

# JWT Secret (change in production!)
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production-use-openssl-rand-hex-32

# Database passwords (change in production!)
POSTGRES_PASSWORD=postgres
GRIDFLOW_PASSWORD=gridflow
SPIFFWORKFLOW_PASSWORD=spiffworkflow

# Optional: Set to enable specific features
# ENABLE_DEBUG=true
