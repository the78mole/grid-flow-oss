# API Gateway Configuration
API_GATEWAY_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
DATABASE_URL=postgresql://gridflow:gridflow@postgres:5432/gridflow
SPIFF_DATABASE_URL=postgresql://spiffworkflow:spiffworkflow@postgres:5432/spiffworkflow

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# SpiffArena Configuration
SPIFF_ARENA_URL=http://spiff-arena:8000

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8001

# Authentication Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# eID Configuration (example - adjust based on your national eID system)
EID_PROVIDER_URL=https://eid-provider.example.com
EID_CLIENT_ID=your-client-id
EID_CLIENT_SECRET=your-client-secret

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=GridFlow PV Registration
WEBAUTHN_ORIGIN=http://localhost:3000
